# src/mission_fsm.py
import math
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Pose, PoseStamped
from std_msgs.msg import Bool
from nav2_simple_commander.robot_navigator import BasicNavigator

class MissionFSM(Node):
    def __init__(self):
        super().__init__('mission_fsm')
        self.state = 'INIT'
        self.goal_pose = None
        self.object_poses = []
        self.object_idx = 0
        self.start_pose = self.create_pose(0.0, 0.0, 0.0)
        self.navigator = BasicNavigator()
        self.navigator.waitUntilNav2Active()

        self.create_timer(0.5, self.loop)
        self.create_subscription(Pose, '/topic/goal_pose', self.goal_cb, 10)
        self.create_subscription(Pose, '/topic/object_pose', self.object_cb, 10)
        self.current_pose = self.start_pose

    def goal_cb(self, msg):
        self.goal_pose = msg
        self.get_logger().info('Goal received')

    def object_cb(self, msg):
        self.object_poses.append(msg)
        self.get_logger().info(f'Object received: {len(self.object_poses)}')

    def create_pose(self, x, y, theta):
        pose = Pose()
        pose.position.x = x
        pose.position.y = y
        pose.orientation.w = 1.0  # no rotation (simple)
        return pose

    def pose_to_stamped(self, pose):
        ps = PoseStamped()
        ps.header.frame_id = 'map'
        ps.header.stamp = self.get_clock().now().to_msg()
        ps.pose = pose
        return ps

    def navigate_to(self, pose):
        self.get_logger().info(f'Navigating to x={pose.position.x:.2f}, y={pose.position.y:.2f}')
        self.navigator.goToPose(self.pose_to_stamped(pose))
        while not self.navigator.isTaskComplete():
            rclpy.spin_once(self, timeout_sec=0.1)

    def reached_target(self, target_pose):
        dx = self.current_pose.position.x - target_pose.position.x
        dy = self.current_pose.position.y - target_pose.position.y
        return math.sqrt(dx**2 + dy**2) < 1.0

    def pick_object(self):
        self.get_logger().info('Picking object...')

    def drop_object(self):
        self.get_logger().info('Dropping object...')

    def loop(self):
        if self.state == 'INIT':
            self.state = 'SLAM_MAPPING'
        elif self.state == 'SLAM_MAPPING':
            if self.goal_pose and len(self.object_poses) >= 2:
                self.state = 'NAV_TO_OBJECT'
        elif self.state == 'NAV_TO_OBJECT':
            target = self.object_poses[self.object_idx]
            self.navigate_to(target)
            self.current_pose = target
            if self.reached_target(target):
                self.state = 'PICK_OBJECT'
        elif self.state == 'PICK_OBJECT':
            self.pick_object()
            self.state = 'NAV_TO_GOAL'
        elif self.state == 'NAV_TO_GOAL':
            self.navigate_to(self.goal_pose)
            self.current_pose = self.goal_pose
            if self.reached_target(self.goal_pose):
                self.state = 'DROP_OBJECT'
        elif self.state == 'DROP_OBJECT':
            self.drop_object()
            if self.object_idx == 1:
                self.state = 'NAV_TO_START'
            else:
                self.object_idx += 1
                self.state = 'NAV_TO_OBJECT'
        elif self.state == 'NAV_TO_START':
            self.navigate_to(self.start_pose)
            if self.reached_target(self.start_pose):
                self.state = 'ALL_DONE'
        elif self.state == 'ALL_DONE':
            self.get_logger().info('All mission complete.')


def main():
    rclpy.init()
    node = MissionFSM()
    rclpy.spin(node)
    rclpy.shutdown()

if __name__ == '__main__':
    main()
