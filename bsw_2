# src/object_goal_mock.py (YOLO 없이 물체/목표 좌표 발행)
#!/usr/bin/env python3
import rospy
from geometry_msgs.msg import Pose

def publish_mock():
    rospy.init_node('object_goal_mock_node')
    pub_obj = rospy.Publisher('/object_pose', Pose, queue_size=2)
    pub_goal = rospy.Publisher('/goal_pose', Pose, queue_size=1)
    rospy.sleep(1.0)

    object1 = Pose()
    object1.position.x = 6.0
    object1.position.y = 6.0
    object1.orientation.w = 1.0

    object2 = Pose()
    object2.position.x = -7.0
    object2.position.y = -7.0
    object2.orientation.w = 1.0

    goal = Pose()
    goal.position.x = 7.0
    goal.position.y = -2.0
    goal.orientation.w = 1.0

    rate = rospy.Rate(1)
    while not rospy.is_shutdown():
        pub_obj.publish(object1)
        pub_obj.publish(object2)
        pub_goal.publish(goal)
        rate.sleep()

if __name__ == '__main__':
    try:
        publish_mock()
    except rospy.ROSInterruptException:
        pass

---
# launch/object_goal_mock.launch
<launch>
  <node pkg="morai_slam_navigation" type="object_goal_mock.py" name="object_goal_mock" output="screen" />
</launch>

