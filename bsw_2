# src/mission_algorithm.py (YOLO 없이 작동하는 FSM 완전 재정리)
#!/usr/bin/env python3
import rospy
import actionlib
import math
from geometry_msgs.msg import Pose
from move_base_msgs.msg import MoveBaseAction, MoveBaseGoal

class MissionFSM:
    def __init__(self):
        rospy.init_node('mission_fsm_node')
        self.goal_pose = None
        self.object_poses = []
        self.object_idx = 0
        self.start_pose = self.create_pose(-19.0, 4.5, 1.0)
        self.finish_pose = self.create_pose(13.0, -9.0, 1.0)
        self.current_pose = self.start_pose

        self.client = actionlib.SimpleActionClient('move_base', MoveBaseAction)
        self.client.wait_for_server()

        rospy.Subscriber('/goal_pose', Pose, self.goal_cb)
        rospy.Subscriber('/object_pose', Pose, self.object_cb)
        rospy.Timer(rospy.Duration(0.5), self.mission_loop)
        self.state = 'WAIT'

    def create_pose(self, x, y, w):
        pose = Pose()
        pose.position.x = x
        pose.position.y = y
        pose.orientation.w = w
        return pose

    def goal_cb(self, msg):
        self.goal_pose = msg

    def object_cb(self, msg):
        if msg not in self.object_poses:
            self.object_poses.append(msg)

    def send_goal(self, pose):
        goal = MoveBaseGoal()
        goal.target_pose.header.frame_id = 'map'
        goal.target_pose.header.stamp = rospy.Time.now()
        goal.target_pose.pose = pose
        self.client.send_goal(goal)
        self.client.wait_for_result()
        self.current_pose = pose

    def distance(self, a, b):
        dx = a.position.x - b.position.x
        dy = a.position.y - b.position.y
        return math.hypot(dx, dy)

    def mission_loop(self, event):
        if self.state == 'WAIT':
            if self.goal_pose and len(self.object_poses) >= 2:
                self.state = 'NAV_TO_OBJECT_1'

        elif self.state == 'NAV_TO_OBJECT_1':
            self.send_goal(self.object_poses[0])
            if self.distance(self.current_pose, self.object_poses[0]) < 1.0:
                self.state = 'PICK_1'

        elif self.state == 'PICK_1':
            self.state = 'NAV_TO_GOAL_1'

        elif self.state == 'NAV_TO_GOAL_1':
            self.send_goal(self.goal_pose)
            if self.distance(self.current_pose, self.goal_pose) < 1.0:
                self.state = 'DROP_1'

        elif self.state == 'DROP_1':
            self.state = 'NAV_TO_OBJECT_2'

        elif self.state == 'NAV_TO_OBJECT_2':
            self.send_goal(self.object_poses[1])
            if self.distance(self.current_pose, self.object_poses[1]) < 1.0:
                self.state = 'PICK_2'

        elif self.state == 'PICK_2':
            self.state = 'NAV_TO_GOAL_2'

        elif self.state == 'NAV_TO_GOAL_2':
            self.send_goal(self.goal_pose)
            if self.distance(self.current_pose, self.goal_pose) < 1.0:
                self.state = 'DROP_2'

        elif self.state == 'DROP_2':
            self.state = 'NAV_TO_FINISH'

        elif self.state == 'NAV_TO_FINISH':
            self.send_goal(self.finish_pose)
            if self.distance(self.current_pose, self.finish_pose) < 1.0:
                self.state = 'DONE'

        elif self.state == 'DONE':
            rospy.loginfo('[🏁] Mission complete.')

if __name__ == '__main__':
    try:
        MissionFSM()
        rospy.spin()
    except rospy.ROSInterruptException:
        pass

